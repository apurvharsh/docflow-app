# Copy this file to .env and fill in the values you need.
# The app stores SQLite/Qdrant data under backend/ by default. Nothing here is
# required just to explore the app with /auth/demo, but real document Q&A needs
# GEMINI_API_KEY.

# --- Gemini (embeddings + RAG answer generation) ---
GEMINI_API_KEY=
# Used automatically if the primary model is rate-limited or unavailable.
GEMINI_GENERATION_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash

# Optional SMTP email notifications for project access changes.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=

# --- Groq (used by the Drafting/Scanner Agno agents; the app still works
#     without it via a deterministic template fallback) ---
GROQ_API_KEY=

# --- Qdrant ---
# Leave both blank to use local on-disk Qdrant storage (./qdrant_data).
# Set QDRANT_URL (+ QDRANT_API_KEY) to point at a hosted/managed cluster instead.
QDRANT_URL=
QDRANT_API_KEY=

# --- Local admin login (used by /login with AUTH_USERNAME/AUTH_PASSWORD) ---
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_SECRET=change-this-secret

# --- Google Sign-In (optional) ---
# 1. Create an OAuth Client ID (Web application) in Google Cloud Console.
# 2. Add this exact Authorized redirect URI:
#    https://your-domain.example.com/api/auth/google/callback
# 3. Paste the client id/secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example.com/api/auth/google/callback

# --- Where the frontend runs (used for CORS + the post-Google-login redirect) ---
FRONTEND_URL=https://your-domain.example.com
